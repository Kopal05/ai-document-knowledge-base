# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/smart_knowledge_base
DB_USERNAME=postgres
DB_PASSWORD=password

# --- JWT ---
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
JWT_EXPIRATION_MS=3600000

# --- CORS ---
CORS_ALLOWED_ORIGIN=http://localhost:3000


# --- Gemini (prod profile only) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-latest

# --- Ollama (local profile only) ---
EMBEDDING_PROVIDER_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER_MODEL=nomic-embed-text
CHAT_PROVIDER_BASE_URL=http://localhost:11434
CHAT_PROVIDER_MODEL=llama3.2

# --- Search / RAG tuning ---
SEARCH_DEFAULT_TOP_K=5
RAG_CONTEXT_CHUNK_COUNT=5

# --- Server ---
SERVER_PORT=8080

# --- Spring profile ---
# Render sets this to "prod" in its dashboard; leave unset locally to use
# the "local" default.
SPRING_PROFILES_ACTIVE=